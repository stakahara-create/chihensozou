<script>
// ---------- clock ----------
function tickClock(){
  const d = new Date();
  document.getElementById('clockDate').textContent = d.toLocaleDateString('ja-JP',{month:'2-digit',day:'2-digit'});
  document.getElementById('clockTime').textContent = d.toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'});
}
tickClock(); setInterval(tickClock, 30000);

// ---------- decorative segment bar (top-left) ----------
const SEG_COUNT = 14;
const segbarEl = document.getElementById('segbar');
for(let i=0;i<SEG_COUNT;i++){ const s = document.createElement('i'); segbarEl.appendChild(s); }
const segEls = [...segbarEl.children];

// ---------- decorative equalizer (bottom bar) ----------
const eqEl = document.getElementById('eq');
const EQ_COUNT = 12;
for(let i=0;i<EQ_COUNT;i++){ const b = document.createElement('i'); eqEl.appendChild(b); }
const eqEls = [...eqEl.children];
function animateEq(){
  eqEls.forEach(b => { b.style.height = (2 + Math.random()* (mode==='idle'?4:12)) + 'px'; });
  requestAnimationFrame(() => setTimeout(animateEq, 140));
}
animateEq();

const miniBarEls = [...document.querySelectorAll('#miniBars em')];
const gaugeFill = document.getElementById('gaugeFill');

// ---------- reactive particle sphere ----------
const canvas = document.getElementById('orbCanvas');
const ctx = canvas.getContext('2d');
const SIZE = 600, CX = SIZE/2, CY = SIZE/2;
let mode = 'idle'; // idle | listening | speaking
let level = 0;
let t = 0;

// generate rigid 3D point cloud (dandelion-ish: several branch clusters)
const POINTS = [];
const CLUSTERS = 9;
for(let c=0;c<CLUSTERS;c++){
  const theta = Math.random()*Math.PI*2;
  const phi = Math.acos(2*Math.random()-1);
  const dir = { x:Math.sin(phi)*Math.cos(theta), y:Math.sin(phi)*Math.sin(theta), z:Math.cos(phi) };
  const n = 14 + Math.floor(Math.random()*10);
  for(let i=0;i<n;i++){
    const spread = 0.55;
    const r = 0.35 + Math.random()*0.65;
    const jitterTheta = theta + (Math.random()-0.5)*spread;
    const jitterPhi = phi + (Math.random()-0.5)*spread;
    POINTS.push({
      x: Math.sin(jitterPhi)*Math.cos(jitterTheta) * r,
      y: Math.sin(jitterPhi)*Math.sin(jitterTheta) * r,
      z: Math.cos(jitterPhi) * r
    });
  }
}
// core dense points
for(let i=0;i<60;i++){
  const theta = Math.random()*Math.PI*2, phi = Math.acos(2*Math.random()-1), r = Math.random()*0.3;
  POINTS.push({ x:Math.sin(phi)*Math.cos(theta)*r, y:Math.sin(phi)*Math.sin(theta)*r, z:Math.cos(phi)*r });
}

// precompute nearest-neighbor edges (rigid distances)
const EDGES = [];
for(let i=0;i<POINTS.length;i++){
  let dists = [];
  for(let j=0;j<POINTS.length;j++){
    if(i===j) continue;
    const dx=POINTS[i].x-POINTS[j].x, dy=POINTS[i].y-POINTS[j].y, dz=POINTS[i].z-POINTS[j].z;
    dists.push({ j, d: dx*dx+dy*dy+dz*dz });
  }
  dists.sort((a,b)=>a.d-b.d);
  const k = 2;
  for(let n=0;n<k;n++){ if(dists[n] && dists[n].d < 0.06) EDGES.push([i, dists[n].j]); }
}

function project(p, angle, scale){
  const cos = Math.cos(angle), sin = Math.sin(angle);
  const x = p.x*cos - p.z*sin;
  const z = p.x*sin + p.z*cos;
  const y = p.y;
  const persp = 1.5 / (1.5 + z);
  return { x: CX + x*scale*persp, y: CY + y*scale*persp, z, persp };
}

function drawOrb(){
  ctx.clearRect(0,0,SIZE,SIZE);
  const lime = '212,255,63';
  const amber = '255,176,32';
  const rgb = mode === 'speaking' ? amber : lime;

  // outer tick ring
  const ringR = 250;
  const segN = 72;
  for(let i=0;i<segN;i++){
    const a = (i/segN)*Math.PI*2;
    const active = ((i + Math.floor(t*8)) % segN) < (mode==='idle' ? 3 : 10);
    const r1 = ringR, r2 = ringR - (i%6===0? 14:8);
    ctx.beginPath();
    ctx.moveTo(CX+Math.cos(a)*r1, CY+Math.sin(a)*r1);
    ctx.lineTo(CX+Math.cos(a)*r2, CY+Math.sin(a)*r2);
    ctx.strokeStyle = active ? `rgba(${rgb},.9)` : 'rgba(255,255,255,.08)';
    ctx.lineWidth = 2;
    ctx.stroke();
  }

  // ambient glow
  const glowR = 180 + level*40;
  const g = ctx.createRadialGradient(CX,CY,10,CX,CY,glowR);
  g.addColorStop(0, `rgba(${rgb},${0.22+level*0.15})`);
  g.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.beginPath(); ctx.arc(CX,CY,glowR,0,Math.PI*2); ctx.fillStyle = g; ctx.fill();

  const angle = t * (mode==='listening' ? 0.5 : 0.18);
  const baseScale = 150 * (1 + level*0.25 + (mode==='speaking' ? 0.06*Math.sin(t*6):0));
  const proj = POINTS.map(p => project(p, angle, baseScale));

  // edges
  ctx.lineWidth = 1;
  EDGES.forEach(([i,j]) => {
    const a = proj[i], b = proj[j];
    const alpha = 0.10 + 0.14*((a.persp+b.persp)/2 - 0.5);
    ctx.strokeStyle = `rgba(${rgb},${Math.max(0.04,alpha)})`;
    ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
  });

  // points
  proj.forEach((p,idx) => {
    const jitter = mode==='listening' ? level*3*Math.sin(t*10+idx) : 0.6*Math.sin(t*1.5+idx);
    const rad = (0.9 + p.persp*1.4) + jitter*0.3;
    ctx.beginPath();
    ctx.arc(p.x, p.y + jitter*0.4, Math.max(0.6,rad), 0, Math.PI*2);
    ctx.fillStyle = `rgba(${rgb},${0.5+p.persp*0.5})`;
    ctx.shadowColor = `rgba(${rgb},0.8)`;
    ctx.shadowBlur = 4;
    ctx.fill();
  });
  ctx.shadowBlur = 0;

  t += 0.016;
  requestAnimationFrame(drawOrb);
}
requestAnimationFrame(drawOrb);

// ---------- mic amplitude analyser (visual only) ----------
let audioCtx = null, analyser = null, analyserData = null, visualStream = null;
async function startVisualAnalyser(){
  try{
    visualStream = await navigator.mediaDevices.getUserMedia({audio:true});
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const src = audioCtx.createMediaStreamSource(visualStream);
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 256;
    src.connect(analyser);
    analyserData = new Uint8Array(analyser.frequencyBinCount);
    pollLevel();
  }catch(e){ /* visual-only enhancement; fail silently */ }
}
function stopVisualAnalyser(){
  if(visualStream){ visualStream.getTracks().forEach(tr=>tr.stop()); visualStream = null; }
  if(audioCtx){ audioCtx.close(); audioCtx = null; }
  level = 0;
  segEls.forEach(s=>s.classList.remove('on'));
  miniBarEls.forEach(m=>m.style.width='0%');
}
function pollLevel(){
  if(!analyser) return;
  analyser.getByteFrequencyData(analyserData);
  let sum = 0;
  for(let i=0;i<analyserData.length;i++) sum += analyserData[i];
  level = Math.min(1, (sum/analyserData.length)/55);
  const onCount = Math.round(level*SEG_COUNT);
  segEls.forEach((s,i)=> s.classList.toggle('on', i<onCount));
  miniBarEls.forEach((m,i)=> m.style.width = Math.max(4, Math.min(100, level*100*(0.6+0.4*Math.random()))) + '%');
  gaugeFill.style.setProperty('--pct', (level*360)+'deg');
  if(mode === 'listening') requestAnimationFrame(pollLevel);
}

// ---------- knowledge snapshot (Slack check performed 2026-08-30) ----------
const STALLED_REPLIES = [
  {
    who: "田中さん(THTマネジメント)",
    what: "契約書の手数料条項について確認待ちの可能性(要目視確認)",
    where: "契約関連スレッド",
    confidence: "低"
  }
];
const SNAPSHOT_NOTE = "2026年8月30日時点でSlack DM(浅見さん・藤田さん・佐竹さん・野村さん・近嵐さん)を確認した限り、直近の受信メッセージはすでに返信済み、または相手からの了承で完結しているものが中心でした。明確に「返信待ち」と断定できるスレッドは今回は見つかりませんでした。";

const KNOWLEDGE = {
  daily_report: "team-新卒チャンネルでは平日18時に@channelで日次報告(粗利KPI・人材紹介決定者数・面談獲得数・面談実施数・送客進捗・先方面談実施数)を送る運用です。2026年8月30日にテンプレートを再構成済みです。",
  referral_partner: "送客パートナー管理システムはFirebase(enovance-referral)+GitHub Pagesで運用中。エノバンス管理画面(index.html)とA社送客管理画面(a.html)が公開済みで、学生登録・承認/非承認・編集/削除がリアルタイム同期します。KGIは粗利250万円(27卒175万円・28卒75万円)です。",
  today: "今日のToDoは特定のタスク管理システムと連携していないため一般的な確認になりますが、18時のteam-新卒日次報告と、返信待ちの可能性があるスレッドの確認をおすすめします。"
};

// ---------- state ----------
let recognizing = false;
let recognition = null;
let awaitingCommand = false;
let awaitingTimer = null;
let wakeModeOn = false;
const WAKE_PATTERNS = ["ヘイゼット","へいぜっと","ヘイズ","へいず","hey z","heyz","ヘイジー","へいじー"];

const orbBtn = document.getElementById('orbBtn');
const statusLine = document.getElementById('statusLine');
const transcript = document.getElementById('transcript');
const emptyTranscript = document.getElementById('emptyTranscript');
const textInput = document.getElementById('textInput');
const sendBtn = document.getElementById('sendBtn');
const micBadgeText = document.getElementById('micBadgeText');
const hudStatus = document.getElementById('hudStatus');
const lastCmd = document.getElementById('lastCmd');

function setMode(m){
  mode = m;
  orbBtn.classList.toggle('on', m !== 'idle');
  hudStatus.textContent = m === 'listening' ? 'LISTENING' : m === 'speaking' ? 'RESPONDING' : (wakeModeOn ? 'ARMED' : 'STANDBY');
}

function setMicBadge(on, label){ micBadgeText.textContent = label; }

function addMessage(role, text){
  if(emptyTranscript) emptyTranscript.remove();
  const el = document.createElement('div');
  el.className = 'msg ' + role;
  const label = document.createElement('div');
  label.className = 'msg-label';
  label.textContent = role === 'user' ? '> YOU' : '> Z';
  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble';
  bubble.textContent = text;
  el.appendChild(label); el.appendChild(bubble);
  transcript.appendChild(el);
  transcript.scrollTop = transcript.scrollHeight;
  lastCmd.textContent = (role==='user'?'質問: ':'応答: ') + text.slice(0,20) + (text.length>20?'…':'');
}

function speak(text){
  setMode('speaking');
  statusLine.innerHTML = '応答中…';
  if('speechSynthesis' in window){
    const utter = new SpeechSynthesisUtterance(text);
    utter.lang = 'ja-JP';
    utter.rate = 1.03;
    utter.onend = () => {
      setMode(wakeModeOn ? 'listening' : 'idle');
      statusLine.innerHTML = '待機中';
    };
    speechSynthesis.speak(utter);
  } else { setMode('idle'); }
}

function routeCommand(q){
  const text = q.trim();
  if(!text) return null;
  const t2 = text.toLowerCase();
  if(t2.includes('滞') || t2.includes('返信') || t2.includes('未読')) return SNAPSHOT_NOTE + (STALLED_REPLIES.length? "\n\n気になった点:\n" + STALLED_REPLIES.map((r,i)=>`${i+1}. ${r.who} — ${r.what}(${r.where}、確信度:${r.confidence})`).join('\n') : " 引き続き、気になるスレッドがあれば教えてください。");
  if(t2.includes('日次') || t2.includes('報告')) return KNOWLEDGE.daily_report;
  if(t2.includes('送客') || t2.includes('パートナー')) return KNOWLEDGE.referral_partner;
  if(t2.includes('今日') && (t2.includes('やる') || t2.includes('todo') || t2.includes('タスク'))) return KNOWLEDGE.today;
  return null;
}

async function callClaude(userText){
  const systemPrompt = `あなたは「Z」という名前の、高原晟也さんの音声パートナーです。仕事の相談にも雑談にも、何でも自由に付き合ってください。
参考までに晟也さんは知変創造(スポーツ協賛セールス、八王子ビートレインズ・山梨クィーンビーズ・上野原サンライズを担当)の代表取締役であり、エノバンス(新卒紹介エージェント)でもチームを率いていますが、話題を仕事に限定する必要はありません。相手が振った話題に自然についていってください。
音声で話しかけられている想定なので、口頭で聞いて自然な、短く簡潔な日本語(2〜4文程度)で答えてください。箇条書きや記号の多用は避け、話し言葉にしてください。分からないことは正直に分からないと言い、想像で具体的な社名・数字を作らないでください。`;
  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 400,
        system: systemPrompt,
        messages: [{ role: "user", content: userText }]
      })
    });
    const data = await response.json();
    const textBlock = (data.content || []).find(b => b.type === 'text');
    return textBlock ? textBlock.text : "うまく応答を生成できませんでした。";
  }catch(e){ return "通信エラーで応答できませんでした。ネットワーク状況を確認してください。"; }
}

async function handleUserUtterance(text){
  addMessage('user', text);
  const canned = routeCommand(text);
  if(canned){ addMessage('assistant', canned); speak(canned); return; }
  statusLine.innerHTML = '考え中…';
  const reply = await callClaude(text);
  addMessage('assistant', reply);
  speak(reply);
}

sendBtn.addEventListener('click', () => {
  const v = textInput.value;
  if(!v.trim()) return;
  textInput.value = '';
  handleUserUtterance(v);
});
textInput.addEventListener('keydown', (e) => { if(e.key === 'Enter') sendBtn.click(); });
document.querySelectorAll('.skill-chip').forEach(chip => {
  chip.addEventListener('click', () => handleUserUtterance(chip.dataset.q));
});

const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
function containsWake(str){ const s = str.toLowerCase(); return WAKE_PATTERNS.some(p => s.includes(p.toLowerCase())); }

function initRecognition(){
  if(!SpeechRecognition){ setMicBadge(false, 'UNSUPPORTED'); return null; }
  const rec = new SpeechRecognition();
  rec.lang = 'ja-JP'; rec.continuous = true; rec.interimResults = true;

  rec.onstart = () => { recognizing = true; setMicBadge(true, awaitingCommand ? 'LISTENING' : 'ARMED'); setMode('listening'); startVisualAnalyser(); };
  rec.onerror = (e) => { setMicBadge(false, 'ERROR'); recognizing = false; setMode('idle'); stopVisualAnalyser(); };
  rec.onend = () => {
    recognizing = false; stopVisualAnalyser();
    if(wakeModeOn){ try{ rec.start(); }catch(e){} }
    else { setMode('idle'); setMicBadge(false, 'OFFLINE'); }
  };
  rec.onresult = (event) => {
    let finalText = '';
    for(let i = event.resultIndex; i < event.results.length; i++){ if(event.results[i].isFinal) finalText += event.results[i][0].transcript; }
    if(!finalText) return;
    if(awaitingCommand){ clearTimeout(awaitingTimer); awaitingCommand = false; handleUserUtterance(finalText.trim()); return; }
    if(containsWake(finalText)){
      let rest = finalText;
      WAKE_PATTERNS.forEach(p => rest = rest.split(p).join(''));
      rest = rest.trim();
      if(rest.length > 1){ handleUserUtterance(rest); }
      else{
        awaitingCommand = true;
        statusLine.innerHTML = 'はい、どうしましたか?';
        speakPrompt();
        awaitingTimer = setTimeout(() => { awaitingCommand = false; statusLine.innerHTML = '待機中'; }, 6000);
      }
    }
  };
  return rec;
}
function speakPrompt(){ if('speechSynthesis' in window){ const u = new SpeechSynthesisUtterance('はい'); u.lang='ja-JP'; speechSynthesis.speak(u); } }

orbBtn.addEventListener('click', () => {
  if(!SpeechRecognition){ statusLine.textContent = '音声認識非対応。テキスト入力をご利用ください。'; return; }
  if(!recognition){ recognition = initRecognition(); if(!recognition) return; }
  if(!wakeModeOn){
    wakeModeOn = true; try{ recognition.start(); }catch(e){}
    statusLine.innerHTML = '常時待機を開始しました';
  } else {
    wakeModeOn = false; try{ recognition.stop(); }catch(e){}
    setMicBadge(false, 'OFFLINE'); setMode('idle'); stopVisualAnalyser();
    statusLine.innerHTML = '停止しました';
  }
});

setMode('idle');
</script>
