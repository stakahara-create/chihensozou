<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Z // SUPERCOMPUTER</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#050503;
    --panel:#0a0a08;
    --line: rgba(255,255,255,.14);
    --line-dim: rgba(255,255,255,.06);
    --text:#eef0e6;
    --text-dim:#7a7d70;
    --lime:#d4ff3f;
    --lime-dim: rgba(212,255,63,.14);
    --amber:#ffb020;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    background:
      radial-gradient(ellipse 70% 50% at 50% 20%, rgba(255,110,40,.10), transparent 60%),
      radial-gradient(ellipse 60% 50% at 50% 100%, rgba(255,80,20,.06), transparent 60%),
      var(--bg);
    color:var(--text);
    font-family:'JetBrains Mono', monospace;
    min-height:100vh;
    display:flex; align-items:center; justify-content:center;
    padding:30px 14px 40px;
  }
  .app{ width:100%; max-width:760px; }

  .screen{
    position:relative;
    background: radial-gradient(ellipse 60% 55% at 50% 42%, rgba(212,255,63,.05), transparent 70%), #060604;
    border:1px solid var(--line);
    padding:20px;
    box-shadow: 0 40px 90px rgba(0,0,0,.6), inset 0 0 60px rgba(0,0,0,.5);
  }
  .corner{ position:absolute; width:20px; height:20px; border-color:rgba(255,255,255,.35); }
  .corner.tl{ top:10px; left:10px; border-top:1.5px solid; border-left:1.5px solid; }
  .corner.tr{ top:10px; right:10px; border-top:1.5px solid; border-right:1.5px solid; }
  .corner.bl{ bottom:10px; left:10px; border-bottom:1.5px solid; border-left:1.5px solid; }
  .corner.br{ bottom:10px; right:10px; border-bottom:1.5px solid; border-right:1.5px solid; }

  /* top bar */
  .topbar{ display:flex; justify-content:space-between; align-items:flex-start; padding:4px 8px 0; }
  .top-left{ display:flex; flex-direction:column; gap:8px; }
  .eyebrow{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:12px; letter-spacing:.14em; color:var(--text); }
  .eyebrow span{ color:var(--text-dim); font-weight:500; font-size:10px; letter-spacing:.08em; margin-left:8px; }
  .segbar{ display:flex; gap:3px; }
  .segbar i{ width:9px; height:5px; background:var(--line-dim); display:block; }
  .segbar i.on{ background:var(--lime); box-shadow:0 0 6px rgba(212,255,63,.7); }
  .readout-pair{ display:flex; gap:18px; font-size:9px; color:var(--text-dim); letter-spacing:.06em; }
  .readout-pair b{ color:var(--text); font-weight:500; }

  .top-right{ text-align:right; }
  .logo{ display:flex; align-items:center; gap:8px; justify-content:flex-end; }
  .logo-mark{ width:20px; height:20px; border:1.4px solid var(--text); border-radius:50% 50% 50% 4px; }
  .logo-text{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:17px; letter-spacing:.02em; }
  .logo-sub{ font-size:9px; color:var(--text-dim); letter-spacing:.14em; margin-top:3px; }

  /* main grid: left panel / orb / right panel */
  .core{
    display:grid; grid-template-columns:118px 1fr 118px; align-items:center;
    gap:10px; padding:18px 4px 6px;
  }
  .side-panel{ display:flex; flex-direction:column; gap:10px; }
  .mini-bars{ display:flex; flex-direction:column; gap:4px; }
  .mini-bars i{ height:5px; background:var(--line-dim); display:block; position:relative; overflow:hidden; }
  .mini-bars i em{ position:absolute; inset:0; background:var(--lime); width:0%; transition:width .25s ease; box-shadow:0 0 6px rgba(212,255,63,.5); font-style:normal; }
  .info-box{
    border:1px solid var(--line-dim); padding:8px 9px; font-size:9.5px; line-height:1.6; color:var(--text-dim);
    letter-spacing:.01em;
  }
  .gauge-wrap{ display:flex; justify-content:flex-end; }
  .gauge{ width:44px; height:44px; border-radius:50%; border:1.4px solid var(--line); position:relative; }
  .gauge-fill{ position:absolute; inset:5px; border-radius:50%; background:conic-gradient(var(--lime) 0deg, var(--lime) var(--pct,40deg), transparent var(--pct,40deg)); opacity:.85; }
  .gauge-core{ position:absolute; inset:13px; border-radius:50%; background:#0a0a08; }

  .orb-stage{ position:relative; width:100%; aspect-ratio:1/1; max-width:290px; margin:0 auto; }
  canvas#orbCanvas{ position:absolute; inset:0; width:100%; height:100%; }
  .orb-btn{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:58px; height:58px; border-radius:50%; border:1px solid rgba(255,255,255,.25); cursor:pointer;
    background:rgba(6,6,4,.6); backdrop-filter:blur(2px);
    display:flex; align-items:center; justify-content:center;
    transition: box-shadow .3s ease, border-color .3s ease, transform .15s ease;
  }
  .orb-btn:active{ transform:translate(-50%,-50%) scale(.94); }
  .orb-btn.on{ border-color:var(--lime); box-shadow:0 0 26px rgba(212,255,63,.45); }
  .orb-btn svg{ width:20px; height:20px; }

  .cta-row{ text-align:center; padding:6px 0 2px; }
  .cta{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:11px; letter-spacing:.22em; color:var(--lime); text-transform:uppercase; }
  .cta b{ color:#fff; }
  .status-sub{ font-size:10px; color:var(--text-dim); margin-top:5px; letter-spacing:.04em; }

  /* bottom command bar */
  .cmdbar{
    margin-top:16px; border:1px solid var(--line-dim); padding:10px 12px; display:flex; flex-direction:column; gap:7px;
  }
  .cmdbar-head{ display:flex; justify-content:space-between; align-items:center; font-size:9px; color:var(--text-dim); letter-spacing:.1em; margin-bottom:2px; }
  .head-right{ display:flex; align-items:center; gap:10px; }
  .cmd-row{
    display:flex; flex-direction:column; gap:5px; font-size:10.5px; color:var(--text-dim);
    padding:7px 0; border-top:1px solid var(--line-dim);
  }
  .cmd-row:first-of-type{ border-top:none; padding-top:3px; }
  .cmd-row b{ color:var(--text); font-weight:500; font-family:'Space Grotesk',sans-serif; font-size:11.5px; }
  .tag-group{ display:flex; flex-wrap:wrap; gap:6px; }
  .tag-group .tag{ font-size:8.5px; padding:2px 7px; border:1px solid var(--line-dim); color:var(--text-dim); letter-spacing:.02em; }
  .status-row{ border-top:1px solid var(--line-dim); padding-top:8px; }
  .status-row b{ font-size:10px; color:var(--text-dim); font-family:'JetBrains Mono',monospace; font-weight:400; }

  .eq{ display:flex; align-items:flex-end; gap:2px; height:14px; margin-left:auto; }
  .eq i{ width:2.5px; background:linear-gradient(180deg, var(--lime), var(--amber)); display:block; height:3px; }

  /* ---------- conversation panel ---------- */
  .console{ margin-top:14px; }
  .transcript{
    display:flex; flex-direction:column; gap:10px;
    max-height:260px; overflow-y:auto; padding-right:2px; margin-bottom:12px;
  }
  .transcript::-webkit-scrollbar{ width:5px; }
  .transcript::-webkit-scrollbar-thumb{ background:var(--line); }
  .msg{ display:flex; flex-direction:column; gap:4px; max-width:90%; font-family:'Space Grotesk',sans-serif; }
  .msg.user{ align-self:flex-end; align-items:flex-end; }
  .msg.assistant{ align-self:flex-start; }
  .msg-label{ font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:.1em; color:var(--text-dim); }
  .msg-bubble{ font-size:13px; line-height:1.6; padding:9px 12px; white-space:pre-wrap; border-left:2px solid var(--line); }
  .msg.user .msg-bubble{ background:rgba(255,176,32,.06); border-left-color:var(--amber); color:#ffe1b0; }
  .msg.assistant .msg-bubble{ background:var(--lime-dim); border-left-color:var(--lime); color:#f2ffcf; }
  .empty-transcript{ text-align:center; color:var(--text-dim); font-size:11px; padding:4px 0; }

  .inputrow{ display:flex; gap:8px; }
  .inputrow input{
    flex:1; background:#0d0d0a; border:1px solid var(--line-dim); color:var(--text);
    padding:10px 13px; font-size:12.5px; font-family:'JetBrains Mono',monospace; outline:none;
  }
  .inputrow input:focus{ border-color:var(--lime); }
  .inputrow input::placeholder{ color:var(--text-dim); }
  .inputrow button{
    background:var(--lime); color:#0a0a06; border:none;
    padding:0 16px; font-size:11px; font-weight:700; letter-spacing:.06em; cursor:pointer;
    font-family:'JetBrains Mono',monospace;
  }
  .inputrow button:hover{ background:#e6ff7a; }

  .skills{ display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-top:10px; }
  .skill-chip{
    background:#0d0d0a; border:1px solid var(--line-dim); padding:8px 11px;
    font-size:10.5px; color:var(--text-dim); cursor:pointer; text-align:left;
    font-family:'JetBrains Mono',monospace;
    transition:border-color .15s ease, color .15s ease;
  }
  .skill-chip::before{ content:"› "; color:var(--lime); }
  .skill-chip:hover{ border-color:var(--lime); color:var(--text); }

  .footnote{
    margin-top:12px; font-size:10px; color:var(--text-dim); line-height:1.7;
    padding:11px 13px; border:1px solid var(--line-dim);
  }
  .footnote b{ color:var(--amber); }

  @media(max-width:560px){
    .core{ grid-template-columns:1fr; }
    .side-panel{ display:none; }
  }
</style>
</head>
